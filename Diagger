class Enhanced3DAxes:
    """Enhanced 3D coordinate system with π-diagonal and annotations"""
    
    def __init__(self, scale: float = 1.5):
        self.scale = scale
        self.origin = np.array([0.0, 0.0, 0.0])
        
        # Unit vectors
        self.ex = np.array([1.0, 0.0, 0.0])
        self.ey = np.array([0.0, 1.0, 0.0])
        self.ez = np.array([0.0, 0.0, 1.0])
        
        # π-diagonal vector
        self.eπ = np.array([1.0, 1.0, 1.0]) / math.sqrt(3)  # Unit vector
        self.π_endpoint = scale * np.array([1.0, 1.0, 1.0])  # Scale to (scale, scale, scale)
        
        # Colors
        self.colors = {
            'x_axis': '#FF4444',    # Red
            'y_axis': '#44FF44',    # Green
            'z_axis': '#4444FF',    # Blue
            'pi_diagonal': '#FFDD44', # Gold/yellow for π
            'square_face': '#666666', # Gray plane
            'grid': '#333333',
            'background': '#000000',
            'text': '#FFFFFF',
            'highlight': '#FFAA00'
        }
    
    def create_figure(self, figsize=(12, 10)) -> plt.Figure:
        """Create the main 3D figure"""
        fig = plt.figure(figsize=figsize, facecolor=self.colors['background'])
        ax = fig.add_subplot(111, projection='3d', 
                            facecolor=self.colors['background'])
        
        # Set viewing angle for better visibility
        ax.view_init(elev=25, azim=45)
        
        # Set limits
        margin = 0.5
        ax.set_xlim(-margin, self.scale + margin)
        ax.set_ylim(-margin, self.scale + margin)
        ax.set_zlim(-margin, self.scale + margin)
        
        # Remove default grid and axes
        ax.grid(False)
        
        return fig, ax
    
    def draw_axes(self, ax):
        """Draw enhanced 3D axes with ticks and labels"""
        
        # X-axis (Red)
        ax.plot([0, self.scale], [0, 0], [0, 0], 
                color=self.colors['x_axis'], linewidth=3, label='X-axis (Rational)')
        ax.text(self.scale + 0.1, 0, 0, 'X', color=self.colors['x_axis'], 
                fontsize=14, fontweight='bold')
        
        # Y-axis (Green)
        ax.plot([0, 0], [0, self.scale], [0, 0],
                color=self.colors['y_axis'], linewidth=3, label='Y-axis (Rational)')
        ax.text(0, self.scale + 0.1, 0, 'Y', color=self.colors['y_axis'],
                fontsize=14, fontweight='bold')
        
        # Z-axis (Blue)
        ax.plot([0, 0], [0, 0], [0, self.scale],
                color=self.colors['z_axis'], linewidth=3, label='Z-axis (Transcendental)')
        ax.text(0, 0, self.scale + 0.1, 'Z', color=self.colors['z_axis'],
                fontsize=14, fontweight='bold')
        
        # Add coordinate ticks
        tick_positions = np.arange(0, self.scale + 0.5, 0.5)
        for tick in tick_positions:
            if tick <= self.scale:
                # X-axis ticks
                ax.plot([tick, tick], [-0.05, 0.05], [0, 0], 
                        color=self.colors['x_axis'], linewidth=1)
                ax.text(tick, -0.1, -0.1, f'{tick:.1f}', 
                        color=self.colors['x_axis'], fontsize=9, ha='center')
                
                # Y-axis ticks
                ax.plot([-0.05, 0.05], [tick, tick], [0, 0],
                        color=self.colors['y_axis'], linewidth=1)
                ax.text(-0.1, tick, -0.1, f'{tick:.1f}',
                        color=self.colors['y_axis'], fontsize=9, ha='center')
                
                # Z-axis ticks
                ax.plot([-0.05, 0.05], [0, 0], [tick, tick],
                        color=self.colors['z_axis'], linewidth=1)
                ax.text(-0.1, -0.1, tick, f'{tick:.1f}',
                        color=self.colors['z_axis'], fontsize=9, ha='center')
    
    def draw_π_diagonal(self, ax):
        """Draw the π-diagonal from origin to endpoint"""
        # Diagonal line
        t = np.linspace(0, self.scale, 200)
        ax.plot(t, t, t, 
                color=self.colors['pi_diagonal'], 
                linewidth=4, 
                label='π-Diagonal',
                alpha=0.9)
        
        # Highlight endpoint
        ax.scatter([self.π_endpoint[0]], [self.π_endpoint[1]], [self.π_endpoint[2]],
                  color=self.colors['highlight'], s=200, marker='*',
                  label=f'π-Endpoint ({self.scale:.1f}, {self.scale:.1f}, {self.scale:.1f})',
                  edgecolors='white', linewidth=2)
        
        # Add π symbol at midpoint
        midpoint = self.π_endpoint / 2
        ax.text(midpoint[0], midpoint[1], midpoint[2], 'π', 
                color=self.colors['pi_diagonal'], fontsize=20, fontweight='bold',
                ha='center', va='center')
        
        # Add projection lines to axes
        self._draw_projection_lines(ax)
    
    def _draw_projection_lines(self, ax):
        """Draw projection lines from diagonal endpoint to axes"""
        # Projection to XY plane
        ax.plot([self.π_endpoint[0], self.π_endpoint[0]], 
                [self.π_endpoint[1], self.π_endpoint[1]], 
                [0, self.π_endpoint[2]], 
                color='white', linestyle='--', alpha=0.4, linewidth=1)
        
        # Projection to XZ plane
        ax.plot([self.π_endpoint[0], self.π_endpoint[0]], 
                [0, self.π_endpoint[1]], 
                [self.π_endpoint[2], self.π_endpoint[2]], 
                color='white', linestyle='--', alpha=0.4, linewidth=1)
        
        # Projection to YZ plane
        ax.plot([0, self.π_endpoint[0]], 
                [self.π_endpoint[1], self.π_endpoint[1]], 
                [self.π_endpoint[2], self.π_endpoint[2]], 
                color='white', linestyle='--', alpha=0.4, linewidth=1)
        
        # Mark intersection points on axes
        for axis, coord in [('x', self.π_endpoint[0]), 
                           ('y', self.π_endpoint[1]), 
                           ('z', self.π_endpoint[2])]:
            if axis == 'x':
                pos = [coord, 0, 0]
            elif axis == 'y':
                pos = [0, coord, 0]
            else:
                pos = [0, 0, coord]
            
            ax.scatter([pos[0]], [pos[1]], [pos[2]], 
                      color='white', s=50, marker='o', alpha=0.7)
            
            label_text = f'{coord:.1f}'
            offset = 0.15
            if axis == 'x':
                ax.text(pos[0] + offset, pos[1], pos[2], label_text,
                       color='white', fontsize=10, ha='left')
            elif axis == 'y':
                ax.text(pos[0], pos[1] + offset, pos[2], label_text,
                       color='white', fontsize=10, ha='center')
            else:
                ax.text(pos[0], pos[1], pos[2] + offset, label_text,
                       color='white', fontsize=10, ha='center')
    
    def draw_square_face(self, ax):
        """Draw the shaded square/parallelogram face (rational plane)"""
        # Square in XY plane at Z=0
        vertices = np.array([
            [0, 0, 0],
            [self.scale, 0, 0],
            [self.scale, self.scale, 0],
            [0, self.scale, 0]
        ])
        
        # Create polygon
        square = Poly3DCollection([vertices], alpha=0.3, 
                                 color=self.colors['square_face'])
        ax.add_collection3d(square)
        
        # Add border
        border = np.array([[0, 0, 0], [self.scale, 0, 0], 
                          [self.scale, self.scale, 0], [0, self.scale, 0], [0, 0, 0]])
        ax.plot(border[:, 0], border[:, 1], border[:, 2],
                color='white', linewidth=2, alpha=0.5, linestyle='-')
        
        # Label the plane
        ax.text(self.scale/2, self.scale/2, -0.1, 'Rational Substrate (XY Plane)',
                color='white', fontsize=11, ha='center', va='center',
                bbox=dict(boxstyle='round', facecolor='black', alpha=0.7))
    
    def add_mathematical_annotations(self, ax):
        """Add mathematical annotations and equations"""
        # Mathematical equations at strategic positions
        
        # Vector equation of π-diagonal
        eq1_pos = [0.5, -0.3, 1.5]
        ax.text(eq1_pos[0], eq1_pos[1], eq1_pos[2],
