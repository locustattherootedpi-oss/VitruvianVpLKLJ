class PiDiagonalAnalyzer:
    """Analyze mathematical properties of the π-diagonal system"""
    
    def __init__(self, scale: float = 1.5):
        self.scale = scale
        self.enhanced_axes = Enhanced3DAxes(scale)
    
    def calculate_properties(self) -> Dict[str, Any]:
        """Calculate mathematical properties of the system"""
        
        # Vector calculations
        diagonal_vector = np.array([self.scale, self.scale, self.scale])
        magnitude = np.linalg.norm(diagonal_vector)
        
        # Projections onto axes
        projection_x = np.dot(diagonal_vector, [1, 0, 0])
        projection_y = np.dot(diagonal_vector, [0, 1, 0])
        projection_z = np.dot(diagonal_vector, [0, 0, 1])
        
        # Angles with axes
        angle_x = math.degrees(math.acos(projection_x / magnitude))
        angle_y = math.degrees(math.acos(projection_y / magnitude))
        angle_z = math.degrees(math.acos(projection_z / magnitude))
        
        # Volume and area calculations
        cube_volume = self.scale ** 3
        diagonal_length = magnitude
        cube_diagonal = math.sqrt(3) * self.scale
        
        # π-related calculations
        pi_ratio = diagonal_length / self.scale
        golden_ratio = (1 + math.sqrt(5)) / 2
        
        return {
            'scale': self.scale,
            'diagonal_vector': diagonal_vector.tolist(),
            'magnitude': magnitude,
            'projections': {
                'x': projection_x,
                'y': projection_y,
                'z': projection_z
            },
            'angles_with_axes': {
                'angle_x': angle_x,
                'angle_y': angle_y,
                'angle_z': angle_z
            },
            'geometry': {
                'cube_volume': cube_volume,
                'diagonal_length': diagonal_length,
                'cube_diagonal': cube_diagonal,
                'surface_area': 6 * self.scale ** 2
            },
            'transcendental_ratios': {
                'pi_ratio': pi_ratio,
                'actual_pi': math.pi,
                'golden_ratio': golden_ratio,
                'ratio_difference': abs(pi_ratio - math.pi)
            }
        }
    
    def create_properties_visualization(self, figsize=(10, 8)) -> plt.Figure:
        """Create a 2D visualization of the mathematical properties"""
        properties = self.calculate_properties()
        
        fig, axes = plt.subplots(2, 2, figsize=figsize, 
                                facecolor=self.enhanced_axes.colors['background'])
        
        # 1. Vector components bar chart
        ax1 = axes[0, 0]
        components = ['X', 'Y', 'Z']
        values = [properties['projections']['x'], 
                 properties['projections']['y'], 
                 properties['projections']['z']]
        
        bars = ax1.bar(components, values, 
                      color=[self.enhanced_axes.colors['x_axis'],
                            self.enhanced_axes.colors['y_axis'],
                            self.enhanced_axes.colors['z_axis']],
                      alpha=0.7)
        
        ax1.set_ylabel('Projection Magnitude')
        ax1.set_title('Vector Projections onto Axes')
        ax1.grid(True, alpha=0.3, axis='y')
        
        # Add value labels on bars
        for bar in bars:
            height = bar.get_height()
            ax1.text(bar.get_x() + bar.get_width()/2., height,
                    f'{height:.2f}', ha='center', va='bottom', color='white')
        
        # 2. Angles pie chart
        ax2 = axes[0, 1]
        angles = [properties['angles_with_axes']['angle_x'],
                 properties['angles_with_axes']['angle_y'],
                 properties['angles_with_axes']['angle_z']]
        
        colors = [self.enhanced_axes.colors['x_axis'],
                 self.enhanced_axes.colors['y_axis'],
                 self.enhanced_axes.colors['z_axis']]
        
        wedges, texts, autotexts = ax2.pie(angles, labels=components, 
                                          colors=colors, autopct='%1.1f°',
                                          startangle=90)
        
        ax2.set_title('Angles with Coordinate Axes')
        
        # 3. Geometry metrics
        ax3 = axes[1, 0]
        geometry_metrics = ['Volume', 'Diagonal\nLength', 'Cube\nDiagonal', 'Surface\nArea']
        geometry_values = [properties['geometry']['cube_volume'],
                          properties['geometry']['diagonal_length'],
                          properties['geometry']['cube_diagonal'],
                          properties['geometry']['surface_area']]
        
        bars3 = ax3.bar(geometry_metrics, geometry_values, 
                       color=self.enhanced_axes.colors['pi_diagonal'], alpha=0.7)
        
        ax3.set_ylabel('Value')
        ax3.set_title('Geometric Properties')
        ax3.grid(True, alpha=0.3, axis='y')
        
        for bar in bars3:
            height = bar.get_height()
            ax3.text(bar.get_x() + bar.get_width()/2., height,
                    f'{height:.2f}', ha='center', va='bottom', color='white')
        
        # 4. Transcendental ratios
        ax4 = axes[1, 1]
        transcendental_labels = ['π Ratio\n(Diag/Scale)', 'Actual π', 'Golden Ratio', 'Difference']
        transcendental_values = [properties['transcendental_ratios']['pi_ratio'],
                               properties['transcendental_ratios']['actual_pi'],
                               properties['transcendental_ratios']['golden_ratio'],
                               properties['transcendental_ratios']['ratio_difference']]
        
        bars4 = ax4.bar(transcendental_labels, transcendental_values,
                       color=[self.enhanced_axes.colors['pi_diagonal'],
                             '#FF6B6B', '#44FF44', '#8888FF'], alpha=0.7)
        
        ax4.set_ylabel('Value')
        ax4.set_title('Transcendental Ratios')
        ax4.grid(True, alpha=0.3, axis='y')
        
        for bar in bars4:
            height = bar.get_height()
            ax4.text(bar.get_x() + bar.get_width()/2., height,
                    f'{height:.4f}', ha='center', va='bottom', color='white', fontsize=8)
        
        # Styling
        for ax in axes.flat:
            ax.set_facecolor(self.enhanced_axes.colors['background'])
            ax.tick_params(colors='white')
            ax.xaxis.label.set_color('white')
            ax.yaxis.label.set_color('white')
            ax.title.set_color('white')
        
        plt.suptitle('π-Diagonal System Mathematical Analysis', 
                    color='white', fontsize=14, fontweight='bold')
        plt.tight_layout()
        
        return fig

