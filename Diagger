    def add_legend_with_style(self, ax):
        """Add a styled legend to the plot"""
        # Create custom legend entries
        legend_elements = [
            mpatches.Patch(color=self.colors['x_axis'], alpha=0.7, label='X-axis (Rational)'),
            mpatches.Patch(color=self.colors['y_axis'], alpha=0.7, label='Y-axis (Rational)'),
            mpatches.Patch(color=self.colors['z_axis'], alpha=0.7, label='Z-axis (Transcendental)'),
            mpatches.Patch(color=self.colors['pi_diagonal'], alpha=0.7, label='π-Diagonal'),
