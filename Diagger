                color=self.colors['highlight'], fontsize=11,
                bbox=dict(boxstyle='round', facecolor='black', alpha=0.8))
        
        # π-Logic interpretation
        eq3_pos = [-0.4, 1.5, 0.5]
        ax.text(eq3_pos[0], eq3_pos[1], eq3_pos[2],
                'π-Logic: Transcendental growth\n' +
                'along equal dimensions',
                color='white', fontsize=10,
                bbox=dict(boxstyle='round', facecolor='black', alpha=0.8),
                ha='left', va='center')
        
        # Add coordinate frame info
        frame_info = [
            'Coordinate Frame:',
            '• X: Rational dimension 1',
            '• Y: Rational dimension 2', 
            '• Z: Transcendental dimension',
            '• π-Diagonal: Equal scaling'
