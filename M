import math

def encode_dn(h, a):
    s = sum((hi*hi)/(ai*ai) for hi, ai in zip(h, a))
    dn = s ** (-0.5)

    q = round(dn * 16)
    q = max(-128, min(127, q))

    b = format(q & 0xFF, '08b')
    term = ''.join('o' if x == '1' else 'k' for x in b)
    hx = format(q & 0xFF, '02X')

    return dn, q, b, term, hx


